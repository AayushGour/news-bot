<!doctype html>
<meta charset="utf-8">
<style>
  :root{
    --bg:#0B0D12; --fg:#F2F5FA; --muted:#8A94A6;
    --accent:#4F8CFF; --accent2:#8B5CF6; --card:#141824;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:#000;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif}
  .slide{
    width:1080px;height:1350px;background:var(--bg);color:var(--fg);
    padding:96px 88px;display:flex;flex-direction:column;position:relative;overflow:hidden;
  }
  .slide::before{
    content:"";position:absolute;top:0;left:0;right:0;height:8px;
    background:linear-gradient(90deg,var(--accent),var(--accent2));
  }
  .kicker{font-size:30px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);font-weight:700}
  .body{flex:1;display:flex;flex-direction:column;justify-content:center;gap:36px;min-height:0}
  h1{font-size:96px;line-height:1.04;font-weight:800;letter-spacing:-.03em}
  h2{font-size:68px;line-height:1.1;font-weight:800;letter-spacing:-.02em}
  .sub{font-size:40px;line-height:1.35;color:var(--muted);font-weight:500}
  ul{list-style:none;display:flex;flex-direction:column;gap:28px}
  li{font-size:38px;line-height:1.32;padding-left:44px;position:relative}
  li::before{content:"";position:absolute;left:0;top:16px;width:20px;height:20px;border-radius:6px;background:var(--accent)}
  .stat{background:var(--card);border-left:8px solid var(--accent);padding:36px 40px;border-radius:16px}
  .stat .v{font-size:84px;font-weight:800;letter-spacing:-.02em}
  .stat .l{font-size:30px;color:var(--muted);margin-top:8px}
  table{width:100%;border-collapse:collapse;font-size:34px}
  td{padding:26px 20px;border-bottom:1px solid #232838}
  td:first-child{color:var(--muted);width:42%}
  td:last-child{font-weight:600}
  .srcs{display:flex;flex-direction:column;gap:22px}
  .srcs div{font-size:26px;color:var(--muted);word-break:break-all;line-height:1.4}
  footer{display:flex;justify-content:space-between;align-items:center;font-size:28px;color:var(--muted)}
  .handle{font-weight:700;color:var(--fg)}
  .center{justify-content:center;text-align:center;align-items:center}
</style>
{% for s in slides %}
<div class="slide" id="slide-{{ loop.index0 }}">
  <div class="kicker">{{ {'hook':'AI NEWS','point':'THE DETAIL','compare':'COMPARISON','takeaway':'WHY IT MATTERS','sources':'SOURCES'}.get(s.type,'AI NEWS') }}</div>
  <div class="body {% if s.type in ['hook','takeaway'] %}center{% endif %}">
    {% if s.type == 'hook' %}<h1>{{ s.headline }}</h1>{% else %}<h2>{{ s.headline }}</h2>{% endif %}
    {% if s.sub %}<div class="sub">{{ s.sub }}</div>{% endif %}
    {% if s.bullets %}<ul>{% for b in s.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
    {% if s.stat %}<div class="stat"><div class="v">{{ s.stat.value }}</div><div class="l">{{ s.stat.label }}</div></div>{% endif %}
    {% if s.rows %}<table>{% for r in s.rows %}<tr><td>{{ r[0] }}</td><td>{{ r[1] }}</td></tr>{% endfor %}</table>{% endif %}
    {% if s.urls %}<div class="srcs">{% for u in s.urls %}<div>{{ u }}</div>{% endfor %}</div>{% endif %}
  </div>
  <footer><span class="handle">@yourhandle</span><span>{{ loop.index }} / {{ slides|length }}</span></footer>
</div>
{% endfor %}
