{
  "mcpServers": {
    "web-search": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp<2",
        "python",
        "/Users/aayushgour/Desktop/harness/tools/web_search/mcp_server.py"
      ],
      "env": {
        "SEARXNG_URL": "http://localhost:8081"
      }
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[mcp]<0.10",
        "graphify-mcp"
      ]
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp",
      "args": []
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    }
  }
}
