# ---------------------------------------------------------------- telegram
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# From @BotFather. This bot delivers approvals AND accepts your DMs.
TELEGRAM_BOT_TOKEN=
# Your own Telegram numeric user id (ask @userinfobot).
# This is the ONLY account allowed to send DMs or press approval buttons.
OPERATOR_USER_ID=
# Comma-separated channel ids to watch.
CHANNEL_IDS=-1001526709058

# ------------------------------------------------------------------ models
# Ollama runs on the HOST, not in Docker (Docker Desktop cannot reach the GPU).
# From inside a container use http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
MODEL_CHEAP=qwen3:4b-instruct
MODEL_GOOD=qwen3.5:9b
# llama3.2-vision does NOT work on Ollama 0.33+: its 'mllama' architecture
# was dropped and the server 500s on load. qwen2.5vl scored 11/11 and 8/8
# on OCR fixtures where llama3.2-vision scored 0.
MODEL_VISION=qwen2.5vl:7b
# MUST be pinned. Unpinned, Ollama loads at full 262144 ctx, claims ~43GB,
# and spills to CPU.
NUM_CTX_CHEAP=8192
NUM_CTX_GOOD=16384
NUM_CTX_VISION=8192

# ---------------------------------------------------------------- research
SEARXNG_URL=http://localhost:8080
TRIAGE_THRESHOLD=6
# Credited at the end of every caption.
SOURCE_CREDIT=@aipost
RESEARCH_CONCURRENCY=3

# ----------------------------------------------------------- media hosting
# Cloudflare R2. Instagram fetches images by URL, so they must be public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# --------------------------------------------------------------- instagram
# Instagram API with Instagram Login (no Facebook Page needed).
IG_USER_ID=
IG_ACCESS_TOKEN=

# ----------------------------------------------------------------- runtime
# Leave true until you have verified previews look right. When false, the
# publish credentials above become mandatory at startup.
DRY_RUN=true
