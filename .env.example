# ---------------------------------------------------------------- telegram
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# From @BotFather. This bot delivers approvals AND accepts your DMs.
TELEGRAM_BOT_TOKEN=
# Your own Telegram numeric user id (ask @userinfobot).
# This is the ONLY account allowed to send DMs or press approval buttons.
OPERATOR_USER_ID=
# Comma-separated channel ids to watch.
CHANNEL_IDS=-1001526709058

# ------------------------------------------------------------------ models
# Which backend serves every model call: `ollama` (local, free, needs the GPU
# box to be awake) or `openrouter` (hosted, costs money, runs anywhere). This
# is the only variable that changes — same stages, same prompts, same schemas.
# Each provider keeps its own model names below, so flipping back and forth
# never means re-typing them.
LLM_PROVIDER=ollama
# Optional per-role overrides (T216): leave unset/blank to use LLM_PROVIDER
# above for that role. Lets one role run local while the others stay
# hosted, or vice versa -- e.g. a hosted "good" model that reliably returns
# unusable completions can be moved to the local one without touching
# cheap/vision. Each value must be "ollama" or "openrouter", same as
# LLM_PROVIDER itself.
LLM_PROVIDER_CHEAP=
LLM_PROVIDER_GOOD=
LLM_PROVIDER_VISION=
# On a sustained OpenRouter 429: retry 3 times, then use the local Ollama
# model for that one call. Free-tier models are shared, so a rate limit can
# last hours and would otherwise stall the whole queue.
FALLBACK_TO_LOCAL=true

# --- ollama (used when LLM_PROVIDER=ollama) ---
# Ollama runs on the HOST, not in Docker (Docker Desktop cannot reach the GPU).
# From inside a container use http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
MODEL_CHEAP=qwen3:4b-instruct
MODEL_GOOD=qwen3.5:9b
# llama3.2-vision does NOT work on Ollama 0.33+: its 'mllama' architecture
# was dropped and the server 500s on load. qwen2.5vl scored 11/11 and 8/8
# on OCR fixtures where llama3.2-vision scored 0.
MODEL_VISION=qwen2.5vl:7b
# MUST be pinned. Unpinned, Ollama loads at full 262144 ctx, claims ~43GB,
# and spills to CPU. Ollama-only: the OpenAI-shaped API has no equivalent, so
# these are not sent when LLM_PROVIDER=openrouter.
NUM_CTX_CHEAP=8192
NUM_CTX_GOOD=16384
NUM_CTX_VISION=8192
# T222/D197: the pre-render verifier's own model/context, pinned LOCAL
# regardless of LLM_PROVIDER/LLM_PROVIDER_GOOD -- it is not one of the
# cheap/good/vision roles above and can never be routed to OpenRouter. Leave
# both blank to inherit whatever MODEL_GOOD/NUM_CTX_GOOD resolve to (so
# Ollama does not reload the model between a `good` call and a `verify`
# call that both ask for the same one).
MODEL_VERIFY=
NUM_CTX_VERIFY=
# Kill switch for the whole pre-render verifier (T224). Advisory either way
# (house rule 15) -- off just means compose() calls it and writes nothing.
VERIFY=true

# --- agentic revision (T301) ---
# Rollback switch. true: an operator's regen note is planned into targeted edits
# (edit slide N, swap an image, check a fact, ...) and checked. false: the old
# behaviour - the note goes to a fresh full compose.
REVISE_ENABLED=true
# Seconds a revision keeps retrying while SearXNG's engines are suspended before
# it drops the search-backed actions and runs the rest. 0 = give up immediately.
REVISE_ENGINES_BLOCKED_MAX_S=1800

# --- openrouter (used when LLM_PROVIDER=openrouter) ---
# Key from https://openrouter.ai/keys. Required only for that provider, and
# checked at startup: without it every call 401s, and a 401 permanently fails
# the item rather than retrying.
OPENROUTER_API_KEY=
# Why these three: every stage passes a JSON Schema, so the default must be a
# model with native OpenAI-style `json_schema` support (there is a json_object
# fallback in llm.py, but it only asks the model nicely and is strictly worse).
# All three below are free-tier slugs, live-tested against this pipeline's
# actual schemas rather than picked from advertised capabilities — see D9/D11
# in .claude/project-context.md for the full test matrix and its caveats.
#
# cheap runs on every single message — triage, research planning, relevance
# gate. Must be free (validate_for_run rejects a paid slug) and pinned to one
# specific model, never an auto-router like openrouter/free or
# openrouter/auto: those pick a different upstream on every call, so quality
# is not reproducible and every A/B measurement becomes noise. A slug's own
# metadata is not trustworthy either — some free models advertise
# structured-output support in the models API and then silently ignore
# response_format at runtime, returning prose where a schema was required.
# Verified live before pinning: sent response_format:json_schema with an enum
# that contradicts the truthful answer and got the schema-honouring answer
# back, not free-form prose.
OPENROUTER_MODEL_CHEAP=nvidia/nemotron-3.5-super-vl:free
# good writes the brief and the slide copy, the only text a human ever reads.
# Live-tested 2026-09-22 against the real SLIDES_SCHEMA: 3/3 conforming
# (D9). Free tier only (rule 9) — never point this at a paid slug.
OPENROUTER_MODEL_GOOD=nvidia/nemotron-3-ultra-550b-a55b:free
# vision OCRs screenshots, and a bad read poisons every stage after it. The
# only vision candidate live-tested so far (D3a) — and it advertises
# structured_outputs:true in the models API, then IGNORES it: it answered
# "2 + 2 = 4" against a schema whose enum was ["banana"]. supported_parameters
# metadata is not trustworthy; extract.py's own verdict-shape and usable-enum
# checks (extract.py:121-127) are what actually enforce the contract on this
# path (coding-standards.md rule 5) -- normalise_slides never sees a vision
# completion, it only runs on slides.
OPENROUTER_MODEL_VISION=google/gemma-4-31b-it:free

# ---------------------------------------------------------------- research
SEARXNG_URL=http://localhost:8080
TRIAGE_THRESHOLD=6
# Slide look: signal | newsprint | blockprint | aurora,
# or 'rotate' to cycle per item for feed variety.
THEME=signal
# Credited at the end of every caption.
SOURCE_CREDIT=@aipost
RESEARCH_CONCURRENCY=3
# Which role writes the research note: cheap or good. "good" is the
# intended destination — the note is the post's substance — but the only
# measurement taken so far showed avg_grounding_ratio -61% and
# items_completed 3->2, so this defaults to cheap until T135 re-measures
# on the current code and clears the flip. Quota-neutral either way: the
# free tier is one account-wide pool shared by every :free slug regardless
# of which role calls it.
RESEARCH_NOTE_ROLE=cheap
# Missed messages replayed on boot. Start at 2-3 for a first run: each one
# costs a full pipeline pass and lands a preview in your Telegram.
BACKFILL_LIMIT=20

# ----------------------------------------------------------- media hosting
# Instagram fetches these images from ITS OWN servers, so the URL must be
# publicly resolvable. localhost cannot work and is rejected at startup.
#
# Simplest: Cloudflare R2 (free, public URL out of the box, no tunnel).
# Any S3-compatible backend also works - MinIO, Backblaze B2, Wasabi, S3 -
# set S3_ENDPOINT and put a tunnel in front so the bucket is reachable:
#   S3_ENDPOINT=http://localhost:9000
#   R2_PUBLIC_BASE=https://your-tunnel-hostname/bucket
S3_ENDPOINT=
S3_REGION=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# --------------------------------------------------------------- retention
# The worker runs a cleanup job every CLEANUP_INTERVAL_S (and ~1 min after
# boot). DB rows, captions, slides JSON and publish_log are ALWAYS kept - only
# files are deleted - so dedupe and publish history survive.
RETENTION_ENABLED=true
# true = log/notify what WOULD happen, change nothing.
RETENTION_DRY_RUN=false
# An item waiting in awaiting_approval this long is auto-rejected and its
# files deleted. 0 disables. needs_input and in-flight items are never touched.
AWAITING_APPROVAL_MAX_DAYS=120
CLEANUP_INTERVAL_S=21600
# Days published/rejected/dropped items keep files after reaching that state.
TERMINAL_MEDIA_GRACE_DAYS=1
# Failed items can be requeued (extract re-reads the original download), so
# they keep every file this long.
FAILED_MEDIA_GRACE_DAYS=30
CLEANUP_PUBLISHED_MEDIA=true
# Delete items/<id>/ objects in the bucket (published only after ig_post_id).
CLEANUP_MINIO=true

# --------------------------------------------------------------- instagram
# Instagram API with Instagram Login (no Facebook Page needed).
IG_USER_ID=
IG_ACCESS_TOKEN=

# ----------------------------------------------------------------- runtime
# Leave true until you have verified previews look right. When false, the
# publish credentials above become mandatory at startup.
DRY_RUN=true
