# ---------------------------------------------------------------- telegram
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# From @BotFather. This bot delivers approvals AND accepts your DMs.
TELEGRAM_BOT_TOKEN=
# Your own Telegram numeric user id (ask @userinfobot).
# This is the ONLY account allowed to send DMs or press approval buttons.
OPERATOR_USER_ID=
# Comma-separated channel ids to watch.
CHANNEL_IDS=-1001526709058

# ------------------------------------------------------------------ models
# Which backend serves every model call: `ollama` (local, free, needs the GPU
# box to be awake) or `openrouter` (hosted, costs money, runs anywhere). This
# is the only variable that changes — same stages, same prompts, same schemas.
# Each provider keeps its own model names below, so flipping back and forth
# never means re-typing them.
LLM_PROVIDER=ollama
# On a sustained OpenRouter 429: retry 3 times, then use the local Ollama
# model for that one call. Free-tier models are shared, so a rate limit can
# last hours and would otherwise stall the whole queue.
FALLBACK_TO_LOCAL=true

# --- ollama (used when LLM_PROVIDER=ollama
# On a sustained OpenRouter 429: retry 3 times, then use the local Ollama
# model for that one call. Free-tier models are shared, so a rate limit can
# last hours and would otherwise stall the whole queue.
FALLBACK_TO_LOCAL=true) ---
# Ollama runs on the HOST, not in Docker (Docker Desktop cannot reach the GPU).
# From inside a container use http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
MODEL_CHEAP=qwen3:4b-instruct
MODEL_GOOD=qwen3.5:9b
# llama3.2-vision does NOT work on Ollama 0.33+: its 'mllama' architecture
# was dropped and the server 500s on load. qwen2.5vl scored 11/11 and 8/8
# on OCR fixtures where llama3.2-vision scored 0.
MODEL_VISION=qwen2.5vl:7b
# MUST be pinned. Unpinned, Ollama loads at full 262144 ctx, claims ~43GB,
# and spills to CPU. Ollama-only: the OpenAI-shaped API has no equivalent, so
# these are not sent when LLM_PROVIDER=openrouter.
NUM_CTX_CHEAP=8192
NUM_CTX_GOOD=16384
NUM_CTX_VISION=8192

# --- openrouter (used when LLM_PROVIDER=openrouter) ---
# Key from https://openrouter.ai/keys. Required only for that provider, and
# checked at startup: without it every call 401s, and a 401 permanently fails
# the item rather than retrying.
OPENROUTER_API_KEY=
# Why these three: every stage passes a JSON Schema, so the default must be a
# model with native OpenAI-style `json_schema` support (there is a json_object
# fallback in llm.py, but it only asks the model nicely and is strictly worse).
# Gemini Flash supports it, takes images, and has a 1M context, so nothing has
# to be truncated on the way in.
#
# cheap runs on every single message — triage, research planning, relevance
# gate — so it is the cheapest schema-following model: $0.10/$0.40 per Mtok.
OPENROUTER_MODEL_CHEAP=google/gemini-2.5-flash-lite
# good writes the brief and the slide copy, the only text a human ever reads.
# $0.30/$2.50 per Mtok; a full post is cents, not dollars.
OPENROUTER_MODEL_GOOD=google/gemini-2.5-flash
# vision OCRs screenshots, and a bad read poisons every stage after it — so
# this is the full Flash, not Lite. Drop it to flash-lite to halve image cost.
OPENROUTER_MODEL_VISION=google/gemini-2.5-flash

# ---------------------------------------------------------------- research
SEARXNG_URL=http://localhost:8080
TRIAGE_THRESHOLD=6
# Slide look: signal | newsprint | blockprint | aurora,
# or 'rotate' to cycle per item for feed variety.
THEME=signal
# Credited at the end of every caption.
SOURCE_CREDIT=@aipost
RESEARCH_CONCURRENCY=3
# Missed messages replayed on boot. Start at 2-3 for a first run: each one
# costs a full pipeline pass and lands a preview in your Telegram.
BACKFILL_LIMIT=20

# ----------------------------------------------------------- media hosting
# Instagram fetches these images from ITS OWN servers, so the URL must be
# publicly resolvable. localhost cannot work and is rejected at startup.
#
# Simplest: Cloudflare R2 (free, public URL out of the box, no tunnel).
# Any S3-compatible backend also works - MinIO, Backblaze B2, Wasabi, S3 -
# set S3_ENDPOINT and put a tunnel in front so the bucket is reachable:
#   S3_ENDPOINT=http://localhost:9000
#   R2_PUBLIC_BASE=https://your-tunnel-hostname/bucket
S3_ENDPOINT=
S3_REGION=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# --------------------------------------------------------------- instagram
# Instagram API with Instagram Login (no Facebook Page needed).
IG_USER_ID=
IG_ACCESS_TOKEN=

# ----------------------------------------------------------------- runtime
# Leave true until you have verified previews look right. When false, the
# publish credentials above become mandatory at startup.
DRY_RUN=true
