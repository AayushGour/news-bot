<h2>{{ s.headline }}</h2>
<div class="vs">
  <div class="col">
    {% if s.left_title %}<div class="colhead">{{ s.left_title }}</div>{% endif %}
    {% for r in s.rows %}<div class="cell">{{ r[0] }}</div>{% endfor %}
  </div>
  <div class="split"></div>
  <div class="col">
    {% if s.right_title %}<div class="colhead alt">{{ s.right_title }}</div>{% endif %}
    {% for r in s.rows %}<div class="cell strong">{{ r[1] }}</div>{% endfor %}
  </div>
</div>
