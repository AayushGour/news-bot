<!doctype html>
<meta charset="utf-8">
{# Theme tokens are operator config, not model output, and go into CSS where
   HTML escaping would corrupt them: quoted font names become &#39; and the
   whole font-family declaration is then invalid. Slide content in the body
   below stays escaped. #}
{% autoescape false %}
<style>
  :root{
    --bg:{{ theme.bg }}; --fg:{{ theme.fg }}; --muted:{{ theme.muted }};
    --accent:{{ theme.accent }}; --accent2:{{ theme.accent2 }};
    --card:{{ theme.card }}; --rule:{{ theme.rule }};
    --font:{{ theme.font }};
    --mono:{{ theme.mono if theme.mono else "ui-monospace, Menlo, monospace" }};
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:#000;font-family:var(--font)}

  /* ---- shared skeleton. Every theme keeps this frame so the deck reads as
         one series; only surface, type and ornament change. ---- */
  .slide{
    width:1080px;height:1350px;background:var(--bg);color:var(--fg);
    padding:96px 88px;display:flex;flex-direction:column;
    position:relative;overflow:hidden;
  }
  .kicker{font-size:30px;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
  .body{
    flex:1;display:flex;flex-direction:column;justify-content:center;
    gap:36px;min-height:0;overflow:hidden;
  }
  .body.center{justify-content:center;text-align:center;align-items:center}
  h1{font-size:96px;line-height:1.04;font-weight:800;letter-spacing:-.03em}
  h2{font-size:68px;line-height:1.10;font-weight:800;letter-spacing:-.02em}
  .sub{font-size:40px;line-height:1.35;color:var(--muted);font-weight:500}
  ul{list-style:none;display:flex;flex-direction:column;gap:28px}
  li{font-size:38px;line-height:1.32;padding-left:44px;position:relative}
  li::before{
    content:"";position:absolute;left:0;top:16px;width:20px;height:20px;
    border-radius:6px;background:var(--accent);
  }
  .stat{background:var(--card);border-left:8px solid var(--accent);
        padding:36px 40px;border-radius:16px}
  .stat .v{font-size:84px;font-weight:800;letter-spacing:-.02em}
  .stat .l{font-size:30px;color:var(--muted);margin-top:8px}
  table{width:100%;border-collapse:collapse;font-size:34px}
  td{padding:26px 20px;border-bottom:1px solid var(--rule)}
  td:first-child{color:var(--muted);width:42%}
  td:last-child{font-weight:600}
  .srcs{display:flex;flex-direction:column;gap:22px}
  .srcs div{font-size:26px;color:var(--muted);word-break:break-all;line-height:1.4}
  footer{display:flex;justify-content:space-between;align-items:center;
         font-size:28px;color:var(--muted)}
  .handle{font-weight:700;color:var(--fg)}


  /* ---- images that came with the story ---- */
  .photo{border-radius:20px;overflow:hidden;background:var(--card);
         max-height:640px;display:flex;align-items:center;justify-content:center}
  .photo img{width:100%;height:100%;object-fit:cover;display:block}
  .inset{border-radius:16px;overflow:hidden;background:var(--card);
         max-height:380px;display:flex;align-items:center;justify-content:center}
  .inset img{width:100%;height:100%;object-fit:cover;display:block}
  /* A background image must never win against the headline sitting on it. */
  .slide.has-bg::after{
    content:"";position:absolute;inset:0;z-index:0;
    background:linear-gradient(180deg,
      color-mix(in srgb, var(--bg) 72%, transparent) 0%,
      color-mix(in srgb, var(--bg) 88%, transparent) 100%);
  }
  .slide.has-bg > *{position:relative;z-index:1}

  .style-blockprint .photo,.style-blockprint .inset{
    border-radius:0;border:5px solid var(--fg);box-shadow:8px 8px 0 var(--fg)}
  .style-newsprint .photo,.style-newsprint .inset{border-radius:0}
  .style-aurora .photo,.style-aurora .inset{border:1px solid var(--rule)}

  /* ---- code: show the real artifact, not a description of it ---- */
  .codeblock{position:relative;background:var(--card);border-radius:18px;
             padding:38px 36px 34px;overflow:hidden}
  .codeblock pre{font-family:var(--mono);font-size:27px;line-height:1.45;
                 white-space:pre;color:var(--fg);overflow:hidden}
  .codeblock .lang{position:absolute;top:0;right:0;background:var(--accent);
                   color:var(--bg);font-family:var(--mono);font-size:20px;
                   letter-spacing:.12em;text-transform:uppercase;padding:8px 16px;
                   border-bottom-left-radius:12px;font-weight:700}
  .sub.small{font-size:32px}

  /* ---- flow: ordered steps, connected ---- */
  ol.flow{list-style:none;display:flex;flex-direction:column;gap:0}
  ol.flow li{display:flex;gap:28px;position:relative;padding:0 0 34px 0}
  ol.flow li:last-child{padding-bottom:0}
  ol.flow li::after{content:"";position:absolute;left:29px;top:62px;bottom:6px;
                    width:3px;background:var(--rule)}
  ol.flow li:last-child::after{display:none}
  ol.flow .n{flex:none;width:60px;height:60px;border-radius:50%;
             background:var(--accent);color:var(--bg);font-weight:800;
             font-size:30px;display:flex;align-items:center;justify-content:center;
             position:relative;z-index:1}
  ol.flow .txt{display:flex;flex-direction:column;gap:8px;padding-top:6px}
  ol.flow b{font-size:36px;font-weight:700;line-height:1.2}
  ol.flow i{font-style:normal;font-size:28px;line-height:1.35;color:var(--muted)}

  /* ---- compare: a genuine two-sided view ---- */
  .vs{display:flex;gap:0;align-items:stretch}
  .vs .col{flex:1;display:flex;flex-direction:column;gap:20px;padding:0 28px}
  .vs .col:first-child{padding-left:0}
  .vs .col:last-child{padding-right:0}
  .vs .split{width:3px;background:var(--rule);flex:none}
  .vs .colhead{font-size:26px;letter-spacing:.14em;text-transform:uppercase;
               font-weight:700;color:var(--muted);padding-bottom:14px;
               border-bottom:3px solid var(--rule)}
  .vs .colhead.alt{color:var(--accent)}
  .vs .cell{font-size:32px;line-height:1.3}
  .vs .cell.strong{font-weight:700}

  /* ---- quote ---- */
  .kicker-sm{font-size:26px;letter-spacing:.16em;text-transform:uppercase;
             color:var(--accent);font-weight:700;margin-bottom:10px}
  blockquote{font-size:54px;line-height:1.24;font-weight:700;letter-spacing:-.015em}
  blockquote::before{content:"\201C";display:block;font-size:120px;line-height:.6;
                     color:var(--accent);margin-bottom:18px}
  .attrib{font-size:30px;color:var(--muted);margin-top:26px}

  /* shrink step for the new types */
  .slide[data-shrink="1"] .codeblock pre{font-size:22px;line-height:1.38}
  .slide[data-shrink="1"] ol.flow b{font-size:30px}
  .slide[data-shrink="1"] ol.flow i{font-size:24px}
  .slide[data-shrink="1"] ol.flow li{padding-bottom:26px}
  .slide[data-shrink="1"] .vs .cell{font-size:27px}
  .slide[data-shrink="1"] blockquote{font-size:44px}

  /* Overflow guard step one: shrink ~14% and re-measure before giving up. */
  .slide[data-shrink="1"] h1{font-size:82px}
  .slide[data-shrink="1"] h2{font-size:58px}
  .slide[data-shrink="1"] .sub{font-size:34px}
  .slide[data-shrink="1"] li{font-size:32px;line-height:1.28}
  .slide[data-shrink="1"] ul{gap:22px}
  .slide[data-shrink="1"] .body{gap:28px}
  .slide[data-shrink="1"] table{font-size:29px}
  .slide[data-shrink="1"] td{padding:20px 16px}
  .slide[data-shrink="1"] .stat .v{font-size:68px}
  .slide[data-shrink="1"] .srcs div{font-size:23px}

  /* ================= SIGNAL — dark, wire-service ==================
     Signature: the top rule is a segmented meter showing position in the
     deck. It encodes real information (how far in you are), which is the
     one thing a reader mid-swipe actually wants to know. */
  .style-signal .kicker{color:var(--accent)}
  .style-signal .meter{
    position:absolute;top:0;left:0;right:0;height:8px;display:flex;gap:3px;
  }
  .style-signal .meter i{flex:1;background:var(--rule)}
  .style-signal .meter i.on{background:linear-gradient(90deg,var(--accent),var(--accent2))}

  /* =============== NEWSPRINT — cool grey, dispatch =================
     Signature: a monospace slug line, the way a wire dispatch is headed.
     Deliberately cool grey rather than warm cream, ink-blue rather than
     terracotta — the warm-cream-and-serif look is everywhere. */
  .style-newsprint .kicker{
    font-family:var(--mono);color:var(--accent2);font-size:24px;letter-spacing:.22em;
  }
  .style-newsprint .slug{
    font-family:var(--mono);font-size:22px;letter-spacing:.16em;
    color:var(--muted);text-transform:uppercase;
    border-bottom:3px solid var(--fg);padding-bottom:18px;margin-bottom:8px;
  }
  .style-newsprint h1{font-weight:700;letter-spacing:-.02em;font-size:88px}
  .style-newsprint h2{font-weight:700;letter-spacing:-.01em}
  .style-newsprint li::before{
    border-radius:0;width:14px;height:14px;top:18px;background:var(--accent2);
  }
  .style-newsprint .stat{
    background:transparent;border-left:6px solid var(--accent2);border-radius:0;
  }
  .style-newsprint td{border-bottom:1px solid var(--rule)}
  .style-newsprint .srcs div{font-family:var(--mono);font-size:23px}
  .style-newsprint footer{border-top:3px solid var(--fg);padding-top:20px;
                          font-family:var(--mono);font-size:24px}

  /* ============== BLOCKPRINT — neo-brutalist ======================
     Signature: content sits in a white box with a hard 12px offset shadow
     on a flat saturated field that changes per slide. No blur, no radius,
     no gradient. The friction is the point. */
  .style-blockprint{padding:64px}
  .style-blockprint .frame{
    flex:1;display:flex;flex-direction:column;min-height:0;
    background:var(--card);border:6px solid var(--fg);
    box-shadow:14px 14px 0 var(--fg);padding:56px 52px;
  }
  .style-blockprint .kicker{
    align-self:flex-start;background:var(--fg);color:var(--card);
    padding:10px 18px;font-size:26px;letter-spacing:.14em;margin-bottom:32px;
  }
  .style-blockprint h1{font-size:100px;font-weight:800;letter-spacing:-.045em;
                       text-transform:uppercase;line-height:.98}
  .style-blockprint h2{font-size:66px;font-weight:800;letter-spacing:-.03em;
                       text-transform:uppercase;line-height:1.02}
  .style-blockprint .sub{color:var(--muted);font-weight:600}
  .style-blockprint li::before{border-radius:0;background:var(--fg);width:24px;height:24px}
  .style-blockprint .stat{
    background:transparent;border:5px solid var(--fg);border-left-width:5px;
    border-radius:0;box-shadow:8px 8px 0 var(--fg);
  }
  .style-blockprint td{border-bottom:3px solid var(--fg)}
  .style-blockprint footer{margin-top:28px;font-weight:700;color:var(--fg)}
  .style-blockprint .srcs div{color:var(--muted)}

  /* ================== AURORA — soft gradient glass =================
     Signature: a frosted card floating on a mesh gradient. The 2026 soft
     premium look, and the only theme here where the background does work. */
  .style-aurora{
    background:
      radial-gradient(1100px 900px at 12% 8%,  #7C3AED 0%, transparent 60%),
      radial-gradient(1000px 800px at 88% 22%, #2563EB 0%, transparent 58%),
      radial-gradient(1200px 900px at 70% 92%, #FB7185 0%, transparent 62%),
      radial-gradient(900px 700px at 20% 85%,  #FDBA74 0%, transparent 60%),
      var(--bg);
  }
  .style-aurora .frame{
    flex:1;display:flex;flex-direction:column;min-height:0;
    background:var(--card);border:1px solid var(--rule);
    border-radius:44px;padding:64px 56px;
    box-shadow:0 30px 80px rgba(0,0,0,.28);
  }
  .style-aurora .kicker{color:var(--accent);margin-bottom:28px}
  .style-aurora h1,.style-aurora h2{text-shadow:0 2px 20px rgba(0,0,0,.25)}
  .style-aurora .sub{color:var(--muted)}
  .style-aurora li::before{
    background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:50%;
  }
  .style-aurora .stat{border-left-color:var(--accent);border-radius:24px}
  .style-aurora td{border-bottom:1px solid var(--rule)}
  .style-aurora footer{margin-top:24px}

  /* per-theme treatment of the new types */
  .style-newsprint .codeblock{background:#E4E6EA;border-left:6px solid var(--accent);
                              border-radius:0}
  .style-newsprint .codeblock .lang{background:var(--accent2);color:#fff;border-radius:0}
  .style-newsprint ol.flow .n{border-radius:0;background:var(--accent)}
  .style-newsprint blockquote{font-family:var(--font);font-weight:700}

  .style-blockprint .codeblock{background:var(--card);border:5px solid var(--fg);
                               border-radius:0;box-shadow:8px 8px 0 var(--fg)}
  .style-blockprint .codeblock .lang{background:var(--fg);color:var(--card);border-radius:0}
  .style-blockprint ol.flow .n{border-radius:0;background:var(--fg);color:var(--card)}
  .style-blockprint ol.flow li::after{background:var(--fg);width:4px}
  .style-blockprint .vs .split,.style-blockprint .vs .colhead{background:none;
                               border-color:var(--fg)}
  .style-blockprint .vs .split{background:var(--fg);width:4px}
  .style-blockprint blockquote{text-transform:uppercase;letter-spacing:-.03em}

  .style-aurora .codeblock{background:rgba(0,0,0,.28);border:1px solid var(--rule);
                           border-radius:22px}
  .style-aurora ol.flow .n{background:linear-gradient(135deg,var(--accent),var(--accent2));
                           color:#1A1033}

</style>
{% endautoescape %}
{% set style = theme.style if theme.style else 'signal' %}
{% for s in slides %}
{% set pos = loop.index %}
{% set field = theme.palette[loop.index0 % theme.palette|length] if theme.palette else None %}
{% set bg = s.image_uri if s.image_mode == 'background' and s.image_uri else None %}
<div class="slide style-{{ style }}{{ ' has-bg' if bg else '' }}" id="slide-{{ loop.index0 }}"
     {% if bg %}style="background-image:url('{{ bg }}');background-size:cover;background-position:center"
     {% elif field %}style="background:{{ field }}"{% endif %}>

  {% if style == 'signal' %}
    {# Segments lit up to the current slide: how far in you are, at a glance. #}
    <div class="meter">
      {%- for _ in slides -%}
        <i class="{{ 'on' if loop.index <= pos else '' }}"></i>
      {%- endfor -%}
    </div>
  {% endif %}

  {% if style == 'newsprint' %}
    <div class="slug">{{ theme.handle }} &middot; {{ theme.kickers.get(s.type, 'DISPATCH') }} &middot; {{ '%02d'|format(loop.index) }} of {{ '%02d'|format(slides|length) }}</div>
  {% else %}
    <div class="kicker">{{ theme.kickers.get(s.type, theme.kickers['hook']) }}</div>
  {% endif %}

  {% if style in ('blockprint', 'aurora') %}<div class="frame">{% endif %}
  <div class="body{% if s.type in ('hook', 'takeaway') %} center{% endif %}">
    {% include 'slides/' ~ s.type ~ '.html.j2' %}
    {% if s.image_mode == 'inset' and s.image_uri and s.type != 'photo' %}
      <div class="inset"><img src="{{ s.image_uri }}" alt=""></div>
    {% endif %}
  </div>
  {% if style in ('blockprint', 'aurora') %}</div>{% endif %}

  <footer>
    <span class="handle">{{ theme.handle }}</span>
    <span>{{ loop.index }} / {{ slides|length }}</span>
  </footer>
</div>
{% endfor %}
