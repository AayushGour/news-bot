<!doctype html>
<meta charset="utf-8">
{# Theme tokens are operator config, not model output, and go into CSS where
   HTML escaping would corrupt them: quoted font names become &#39; and the
   whole font-family declaration is then invalid. Slide content in the body
   below stays escaped. #}
{% autoescape false %}
<style>
  :root{
    --bg:{{ theme.bg }}; --fg:{{ theme.fg }}; --muted:{{ theme.muted }};
    --accent:{{ theme.accent }}; --accent2:{{ theme.accent2 }};
    --card:{{ theme.card }}; --rule:{{ theme.rule }};
    --font:{{ theme.font }};
    --mono:{{ theme.mono if theme.mono else "ui-monospace, Menlo, 'JetBrains Mono', monospace" }};
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:#000;font-family:var(--font)}

  /* ---- shared skeleton. Every theme keeps this frame so the deck reads as
         one series; only surface, type and ornament change. ---- */
  .slide{
    width:1080px;height:1350px;background:var(--bg);color:var(--fg);
    padding:96px 88px;display:flex;flex-direction:column;
    position:relative;overflow:hidden;
  }
  .kicker{font-size:30px;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
  .body{
    flex:1;display:flex;flex-direction:column;justify-content:center;
    gap:36px;min-height:0;overflow:hidden;
  }
  .body.center{justify-content:center;text-align:center;align-items:center}
  h1{font-size:96px;line-height:1.04;font-weight:800;letter-spacing:-.03em}
  h2{font-size:68px;line-height:1.10;font-weight:800;letter-spacing:-.02em}
  .sub{font-size:40px;line-height:1.35;color:var(--muted);font-weight:500}
  ul{list-style:none;display:flex;flex-direction:column;gap:28px}
  li{font-size:38px;line-height:1.32;padding-left:44px;position:relative}
  li::before{
    content:"";position:absolute;left:0;top:16px;width:20px;height:20px;
    border-radius:6px;background:var(--accent);
  }
  .stat{background:var(--card);border-left:8px solid var(--accent);
        padding:36px 40px;border-radius:16px}
  .stat .v{font-size:84px;font-weight:800;letter-spacing:-.02em}
  .stat .l{font-size:30px;color:var(--muted);margin-top:8px}
  table{width:100%;border-collapse:collapse;font-size:34px}
  td{padding:26px 20px;border-bottom:1px solid var(--rule)}
  td:first-child{color:var(--muted);width:42%}
  td:last-child{font-weight:600}
  .srcs{display:flex;flex-direction:column;gap:22px}
  .srcs div{font-size:26px;color:var(--muted);word-break:break-all;line-height:1.4}
  footer{display:flex;justify-content:space-between;align-items:center;
         font-size:28px;color:var(--muted)}
  .handle{font-weight:700;color:var(--fg)}


  /* ---- chart: horizontal bars, one series, one hue ----
     A single series needs no legend — the headline names it — and one hue
     avoids categorical colour-vision pairing entirely. Every bar is directly
     labelled because a static PNG has no tooltip to fall back on. */
  .chart{display:flex;flex-direction:column;gap:26px}
  .crow{display:grid;grid-template-columns:250px 1fr 150px;align-items:center;gap:22px}
  .clabel{font-size:30px;color:var(--muted);text-align:right;line-height:1.2}
  .ctrack{height:52px;background:var(--card);border-radius:8px;overflow:hidden}
  .cbar{
    height:100%;background:var(--accent);
    /* rounded data-end only, anchored flat to the baseline */
    border-radius:0 8px 8px 0;min-width:6px;
  }
  .cval{font-size:34px;font-weight:700;letter-spacing:-.01em}
  .cunit{font-size:26px;color:var(--muted);margin-top:-8px}

  /* ---- kpi tiles: headline figures that stand alone ---- */
  .kpis{display:grid;gap:26px}
  .kpis-2{grid-template-columns:repeat(2,1fr)}
  .kpis-3{grid-template-columns:repeat(3,1fr)}
  .kpis-4{grid-template-columns:repeat(2,1fr)}
  .tile{
    background:var(--card);border-radius:20px;padding:36px 32px;
    border-left:8px solid var(--accent);display:flex;flex-direction:column;gap:6px;
  }
  .tval{font-size:76px;font-weight:800;letter-spacing:-.03em;line-height:1}
  .kpis-3 .tval,.kpis-4 .tval{font-size:60px}
  .tdelta{font-size:30px;font-weight:700;color:var(--accent)}
  .tlabel{font-size:27px;color:var(--muted);line-height:1.25;margin-top:6px}

  /* ---- images that came with the story ---- */
  /* contain, never cover: a screenshot or chart loses its meaning the moment
     an edge is cut off. The container takes the letterboxing instead. Only the
     blurred background below may crop, because there nothing is being read. */
  .photo{border-radius:20px;overflow:hidden;background:var(--card);
         max-height:660px;display:flex;align-items:center;justify-content:center}
  /* The image stays inside the box's border (blockprint, sketchbook draw
     one), or the clipped edge reads as overflow on every render (T371). */
  .photo img{max-width:100%;max-height:640px;width:auto;height:auto;
             object-fit:contain;display:block}
  .inset{border-radius:16px;overflow:hidden;background:var(--card);
         max-height:390px;display:flex;align-items:center;justify-content:center;
         padding:10px}
  .inset img{max-width:100%;max-height:370px;width:auto;height:auto;
             object-fit:contain;display:block}
  /* A photographic background is the most graphic treatment available, but it
     only works if the headline unambiguously wins. Three things make that true:
     the image is blurred so its own text stops competing for reading, it is
     darkened toward the centre where the headline sits, and every foreground
     element is lifted above it. Without the blur, a screenshot background
     leaves two competing blocks of legible text on one slide. */
  .slide .bg{position:absolute;inset:0;z-index:0;overflow:hidden}
  .slide .bg img{
    width:100%;height:100%;object-fit:cover;display:block;
    filter:blur(5px) saturate(1.25) contrast(1.08) brightness(.92);
    transform:scale(1.08);            /* hide the blur's soft edge */
  }
  .slide.has-bg::after{
    content:"";position:absolute;inset:0;z-index:1;
    /* Tuned by eye against a real screenshot: heavy enough that the headline
       reads instantly, light enough that the image still reads as a
       photograph. Darkening it further wins legibility and loses the reason
       for using a picture at all. */
    background:
      radial-gradient(130% 85% at 50% 52%,
        color-mix(in srgb, var(--bg) 74%, transparent) 0%,
        color-mix(in srgb, var(--bg) 42%, transparent) 72%),
      linear-gradient(180deg,
        color-mix(in srgb, var(--bg) 46%, transparent) 0%,
        color-mix(in srgb, var(--bg) 66%, transparent) 100%);
  }
  .slide.has-bg > *:not(.bg){position:relative;z-index:2}
  .slide.has-bg h1,.slide.has-bg h2{text-shadow:0 4px 30px rgba(0,0,0,.55)}
  .slide.has-bg .sub{color:var(--fg);opacity:.92}

  .style-blockprint .photo,.style-blockprint .inset{
    border-radius:0;border:5px solid var(--fg);box-shadow:8px 8px 0 var(--fg)}
  .style-newsprint .photo,.style-newsprint .inset{border-radius:0}
  .style-aurora .photo,.style-aurora .inset{border:1px solid var(--rule)}

  /* ---- code: show the real artifact, not a description of it ---- */
  .codeblock{position:relative;background:var(--card);border-radius:18px;
             padding:38px 36px 34px;overflow:hidden}
  .codeblock pre{font-family:var(--mono);font-size:27px;line-height:1.45;
                 white-space:pre-wrap;overflow-wrap:anywhere;color:var(--fg);overflow:hidden}
  .codeblock .lang{position:absolute;top:0;right:0;background:var(--accent);
                   color:var(--bg);font-family:var(--mono);font-size:20px;
                   letter-spacing:.12em;text-transform:uppercase;padding:8px 16px;
                   border-bottom-left-radius:12px;font-weight:700}
  .sub.small{font-size:32px}

  /* ---- flow: ordered steps, connected ---- */
  ol.flow{list-style:none;display:flex;flex-direction:column;gap:0}
  ol.flow li{display:flex;gap:28px;position:relative;padding:0 0 34px 0}
  ol.flow li:last-child{padding-bottom:0}
  ol.flow li::after{content:"";position:absolute;left:29px;top:62px;bottom:6px;
                    width:3px;background:var(--rule)}
  ol.flow li:last-child::after{display:none}
  ol.flow .n{flex:none;width:60px;height:60px;border-radius:50%;
             background:var(--accent);color:var(--bg);font-weight:800;
             font-size:30px;display:flex;align-items:center;justify-content:center;
             position:relative;z-index:1}
  ol.flow .txt{display:flex;flex-direction:column;gap:8px;padding-top:6px}
  ol.flow b{font-size:36px;font-weight:700;line-height:1.2}
  ol.flow i{font-style:normal;font-size:28px;line-height:1.35;color:var(--muted)}

  /* ---- compare: a genuine two-sided view ---- */
  .vs{display:flex;gap:0;align-items:stretch}
  .vs .col{flex:1;display:flex;flex-direction:column;gap:20px;padding:0 28px}
  .vs .col:first-child{padding-left:0}
  .vs .col:last-child{padding-right:0}
  .vs .split{width:3px;background:var(--rule);flex:none}
  .vs .colhead{font-size:26px;letter-spacing:.14em;text-transform:uppercase;
               font-weight:700;color:var(--muted);padding-bottom:14px;
               border-bottom:3px solid var(--rule)}
  .vs .colhead.alt{color:var(--accent)}
  .vs .cell{font-size:32px;line-height:1.3}
  .vs .cell.strong{font-weight:700}

  /* ---- repo: one repository, everything needed to find it ----
     The name, the language, the stars and the URL are the four things a
     reader uses to decide whether to go and look. Burying any of them in
     prose makes the slide prettier and less useful. */
  /* The repo slide sets its own rhythm: a tight identity block, then air,
     then the description and link. The shared 36px body gap is too loose
     between the owner line and the name, which belong together. */
  .body .repohead{display:flex;align-items:center;gap:26px;margin-top:18px}
  .body .repometa{margin-top:-14px}
  .repologo{
    width:96px;height:96px;border-radius:24px;flex:none;object-fit:cover;
    background:var(--card);
  }
  .repoid{min-width:0}
  .repoowner{font-family:var(--mono);font-size:30px;color:var(--muted);line-height:1.1}
  .reponame{
    font-size:60px;font-weight:800;letter-spacing:-.025em;line-height:1.05;
    word-break:break-word;
  }
  .repometa{display:flex;gap:16px;align-items:center;margin-top:-8px}
  .badge{
    font-family:var(--mono);font-size:24px;letter-spacing:.06em;
    background:var(--card);color:var(--fg);padding:8px 18px;border-radius:999px;
  }
  .stars{font-size:28px;font-weight:700;color:var(--accent)}
  /* Sits with the description rather than being pushed to the floor: an
     margin-top:auto here split the slide into a crowded top and an empty
     middle, and dropped the URL onto the footer. */
  /* A repo card carried only a name, a badge and a URL, leaving most of a
     1080x1350 slide empty. The description and bullets fill it; both are
     sized down from the deck defaults so a card with four points still
     breathes, and the renderer's shrink pass handles anything longer. */
  .repodesc{margin-top:14px}
  .repobullets{margin-top:10px;display:flex;flex-direction:column;gap:12px}
  .repobullets li{font-size:30px;line-height:1.3;padding-left:38px}
  .slide[data-shrink="1"] .repodesc{font-size:27px}
  .slide[data-shrink="1"] .repobullets li{font-size:25px;line-height:1.26}
  .repourl{
    font-family:var(--mono);font-size:26px;color:var(--accent);
    word-break:break-all;line-height:1.35;padding-top:22px;
    border-top:2px solid var(--rule);
  }

  /* ---- links: every URL in one place, so the deck is actionable ---- */
  ol.linklist{list-style:none;display:flex;flex-direction:column;gap:18px}
  ol.linklist li{display:flex;gap:18px;align-items:baseline;padding-left:0}
  /* The base li rule draws a square marker for bullet lists. Numbered lists
     carry their own, and two markers on one row reads as a rendering fault. */
  ol.linklist li::before,ol.flow li::before{display:none}
  ol.linklist .ln{
    font-family:var(--mono);font-size:24px;color:var(--bg);background:var(--accent);
    border-radius:8px;padding:3px 11px;flex:none;font-weight:700;
  }
  ol.linklist .lu{
    font-family:var(--mono);font-size:27px;line-height:1.3;word-break:break-all;
  }

  .style-blockprint .repologo,.style-blockprint .badge{border-radius:0}
  .style-blockprint .badge{border:3px solid var(--fg)}
  .style-blockprint ol.linklist .ln{border-radius:0}
  .style-newsprint .repologo,.style-newsprint .badge,
  .style-newsprint ol.linklist .ln{border-radius:0}

  .slide[data-shrink="1"] .reponame{font-size:48px}
  .slide[data-shrink="1"] .repologo{width:76px;height:76px}
  .slide[data-shrink="1"] .repourl{font-size:22px}
  .slide[data-shrink="1"] ol.linklist .lu{font-size:22px}
  .slide[data-shrink="1"] ol.linklist{gap:13px}

  /* ---- follow: the closing call to action ---- */
  .follow{display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px}
  .fmark{
    font-size:44px;font-weight:800;letter-spacing:-.02em;color:var(--accent);
    border:4px solid var(--accent);border-radius:999px;padding:16px 40px;
    margin-bottom:14px;
  }
  .style-blockprint .fmark{border-radius:0;background:var(--fg);color:var(--card);
                           border-color:var(--fg)}
  .style-newsprint .fmark{border-radius:0}

  /* ---- quote ---- */
  .kicker-sm{font-size:26px;letter-spacing:.16em;text-transform:uppercase;
             color:var(--accent);font-weight:700;margin-bottom:10px}
  blockquote{font-size:54px;line-height:1.24;font-weight:700;letter-spacing:-.015em}
  blockquote::before{content:"\201C";display:block;font-size:120px;line-height:.6;
                     color:var(--accent);margin-bottom:18px}
  .attrib{font-size:30px;color:var(--muted);margin-top:26px}

  /* shrink step for the new types */
  .slide[data-shrink="1"] .codeblock pre{font-size:22px;line-height:1.38}
  .slide[data-shrink="1"] ol.flow b{font-size:30px}
  .slide[data-shrink="1"] ol.flow i{font-size:24px}
  .slide[data-shrink="1"] ol.flow li{padding-bottom:26px}
  .slide[data-shrink="1"] .vs .cell{font-size:27px}
  .slide[data-shrink="1"] blockquote{font-size:44px}

  /* Overflow guard step one: shrink ~14% and re-measure before giving up. */
  .slide[data-shrink="1"] h1{font-size:82px}
  .slide[data-shrink="1"] h2{font-size:58px}
  .slide[data-shrink="1"] .sub{font-size:34px}
  .slide[data-shrink="1"] li{font-size:32px;line-height:1.28}
  .slide[data-shrink="1"] ul{gap:22px}
  .slide[data-shrink="1"] .body{gap:28px}
  .slide[data-shrink="1"] .photo{max-height:480px}
  .slide[data-shrink="1"] .photo img{max-height:460px}
  .slide[data-shrink="1"] table{font-size:29px}
  .slide[data-shrink="1"] td{padding:20px 16px}
  .slide[data-shrink="1"] .stat .v{font-size:68px}
  .slide[data-shrink="1"] .srcs div{font-size:23px}

  /* ================= notes: rendered Markdown (T362) =================
     Additive and scoped to .mdbody: nothing above changes for existing slide
     types. The generic ul/li/table/blockquote rules still apply inside, so each
     one is re-stated here only where a Markdown body needs something different. */
  .mdbody{display:flex;flex-direction:column;gap:26px;min-height:0;overflow:hidden;
          font-size:36px;line-height:1.34;width:100%}
  .mdbody p{font-size:38px;line-height:1.34}
  .mdbody p.mdh{font-weight:800;color:var(--accent);font-size:40px}
  .mdbody strong{font-weight:800}
  .mdbody em{font-style:italic}
  .mdbody ul,.mdbody ol{display:flex;flex-direction:column;gap:20px;list-style:none}
  .mdbody li{font-size:36px;line-height:1.3}
  .mdbody li>p{display:inline;font-size:inherit}
  .mdbody li>ul,.mdbody li>ol{margin-top:14px;gap:12px}
  .mdbody li li{font-size:32px}
  .mdbody ol{counter-reset:md}
  .mdbody ol>li{counter-increment:md;padding-left:66px}
  .mdbody ol>li::before{
    content:counter(md);width:44px;height:44px;top:2px;border-radius:50%;
    background:var(--accent);color:var(--bg);font-size:26px;font-weight:800;
    line-height:44px;text-align:center;
  }
  .mdbody blockquote{font-size:40px;line-height:1.28;font-weight:700;
                     border-left:8px solid var(--accent);padding:4px 0 4px 32px;letter-spacing:0}
  .mdbody blockquote::before{display:none}
  .mdbody blockquote p{font-size:inherit}
  .mdbody table{width:100%;font-size:30px;table-layout:auto}
  .mdbody th{text-align:left;font-size:24px;letter-spacing:.1em;text-transform:uppercase;
             color:var(--accent);padding:14px 18px;border-bottom:3px solid var(--accent)}
  .mdbody td{padding:18px;vertical-align:top;overflow-wrap:anywhere}
  .mdbody td:first-child{color:var(--fg);width:auto;font-weight:700}
  .mdbody td:last-child{font-weight:400}
  .slide[data-shrink="1"] .mdbody{gap:20px}
  .slide[data-shrink="1"] .mdbody p{font-size:32px}
  .slide[data-shrink="1"] .mdbody p.mdh{font-size:34px}
  .slide[data-shrink="1"] .mdbody li{font-size:30px}
  .slide[data-shrink="1"] .mdbody li li{font-size:27px}
  .slide[data-shrink="1"] .mdbody ul,.slide[data-shrink="1"] .mdbody ol{gap:14px}
  .slide[data-shrink="1"] .mdbody ol>li{padding-left:58px}
  .slide[data-shrink="1"] .mdbody ol>li::before{width:38px;height:38px;line-height:38px;font-size:22px}
  .slide[data-shrink="1"] .mdbody blockquote{font-size:33px}
  .slide[data-shrink="1"] .mdbody table{font-size:25px}
  .slide[data-shrink="1"] .mdbody th{font-size:20px;padding:10px 14px}
  .slide[data-shrink="1"] .mdbody td{padding:12px 14px}

  /* ================= SIGNAL — dark, wire-service ==================
     Signature: the top rule is a segmented meter showing position in the
     deck. It encodes real information (how far in you are), which is the
     one thing a reader mid-swipe actually wants to know. */
  .style-signal .kicker{color:var(--accent)}
  .style-signal .meter{
    position:absolute;top:0;left:0;right:0;height:8px;display:flex;gap:3px;
  }
  .style-signal .meter i{flex:1;background:var(--rule)}
  .style-signal .meter i.on{background:linear-gradient(90deg,var(--accent),var(--accent2))}

  /* =============== NEWSPRINT — cool grey, dispatch =================
     Signature: a monospace slug line, the way a wire dispatch is headed.
     Deliberately cool grey rather than warm cream, ink-blue rather than
     terracotta — the warm-cream-and-serif look is everywhere. */
  .style-newsprint .kicker{
    font-family:var(--mono);color:var(--accent2);font-size:24px;letter-spacing:.22em;
  }
  .style-newsprint .slug{
    font-family:var(--mono);font-size:22px;letter-spacing:.16em;
    color:var(--muted);text-transform:uppercase;
    border-bottom:3px solid var(--fg);padding-bottom:18px;margin-bottom:8px;
  }
  .style-newsprint h1{font-weight:700;letter-spacing:-.02em;font-size:88px}
  .style-newsprint h2{font-weight:700;letter-spacing:-.01em}
  .style-newsprint li::before{
    border-radius:0;width:14px;height:14px;top:18px;background:var(--accent2);
  }
  .style-newsprint .stat{
    background:transparent;border-left:6px solid var(--accent2);border-radius:0;
  }
  .style-newsprint td{border-bottom:1px solid var(--rule)}
  .style-newsprint .srcs div{font-family:var(--mono);font-size:23px}
  .style-newsprint footer{border-top:3px solid var(--fg);padding-top:20px;
                          font-family:var(--mono);font-size:24px}

  /* ============== BLOCKPRINT — neo-brutalist ======================
     Signature: content sits in a white box with a hard 12px offset shadow
     on a flat saturated field that changes per slide. No blur, no radius,
     no gradient. The friction is the point. */
  .style-blockprint{padding:64px}
  .style-blockprint .frame{
    flex:1;display:flex;flex-direction:column;min-height:0;
    background:var(--card);border:6px solid var(--fg);
    box-shadow:14px 14px 0 var(--fg);padding:56px 52px;
  }
  .style-blockprint .kicker{
    align-self:flex-start;background:var(--fg);color:var(--card);
    padding:10px 18px;font-size:26px;letter-spacing:.14em;margin-bottom:32px;
  }
  .style-blockprint h1{font-size:100px;font-weight:800;letter-spacing:-.045em;
                       text-transform:uppercase;line-height:.98}
  .style-blockprint h2{font-size:66px;font-weight:800;letter-spacing:-.03em;
                       text-transform:uppercase;line-height:1.02}
  .style-blockprint .sub{color:var(--muted);font-weight:600}
  .style-blockprint li::before{border-radius:0;background:var(--fg);width:24px;height:24px}
  .style-blockprint .stat{
    background:transparent;border:5px solid var(--fg);border-left-width:5px;
    border-radius:0;box-shadow:8px 8px 0 var(--fg);
  }
  .style-blockprint td{border-bottom:3px solid var(--fg)}
  .style-blockprint footer{margin-top:28px;font-weight:700;color:var(--fg)}
  .style-blockprint .srcs div{color:var(--muted)}

  /* ================ SKETCHBOOK — marker on cream paper ==============
     Signature: everything looks drawn by hand a minute ago. A wobbly ink
     frame, a rounded marker face, one orange highlighter, and the small
     imperfections that separate "hand-drawn" from "rounded rectangle".

     The wobble is the whole trick, and it is not a border-radius: four
     mismatched horizontal and vertical radii make each corner a different
     curve, which is what an unsteady hand actually produces. A uniform
     radius reads as a UI card no matter how thick the stroke. */
  .style-sketchbook{padding:76px 72px 64px;position:relative}
  /* The texture lives on an overlay, not on the slide's own background.
     Each slide gets an inline `background:` from the palette, and that is a
     SHORTHAND — it resets background-image, so a texture declared here would
     be silently wiped on every slide. */
  .style-sketchbook::before{
    content:"";position:absolute;inset:0;pointer-events:none;z-index:0;
    background-image:
      radial-gradient(circle at 18% 22%, rgba(122,82,48,.05) 0 2px, transparent 2px),
      radial-gradient(circle at 73% 61%, rgba(122,82,48,.04) 0 2px, transparent 2px),
      radial-gradient(circle at 41% 84%, rgba(122,82,48,.045) 0 2px, transparent 2px),
      radial-gradient(760px 620px at 50% 42%, rgba(255,255,255,.5), transparent 72%);
    background-size:170px 170px, 230px 230px, 290px 290px, 100% 100%;
  }
  /* Everything real sits above the paper. */
  .style-sketchbook > *{position:relative;z-index:1}
  /* The ink border is the sheet's own edge, drawn as an overlay rather than
     an inner box, so the label and the footer sit INSIDE it — one hand-drawn
     rectangle around everything, which is what the reference does. An inner
     .frame would have put the kicker outside the line. */
  .style-sketchbook::after{
    content:"";position:absolute;inset:34px;pointer-events:none;z-index:0;
    border:5px solid var(--fg);
    border-radius:255px 18px 225px 18px/18px 225px 18px 255px;
  }
  /* A notebook page fills from the top. Centring every slide left wide empty
     bands above and below the content once the border made them visible. */
  .style-sketchbook .body:not(.center){justify-content:flex-start}
  /* The kicker is a marker-drawn label, filled and slightly out of true. */
  .style-sketchbook .kicker{
    align-self:flex-start;background:var(--accent);color:#FFFDF7;
    padding:10px 26px 12px;font-size:28px;letter-spacing:.04em;
    margin-bottom:30px;font-weight:700;text-transform:none;
    border:3px solid var(--fg);
    border-radius:240px 16px 200px 16px/16px 200px 16px 240px;
    transform:rotate(-1.1deg);
  }
  .style-sketchbook h1{
    font-size:92px;font-weight:700;line-height:1.05;letter-spacing:-.01em;
    position:relative;
  }
  /* Two strokes, not one: a hand underlining something draws over it twice
     and never quite retraces the first line. */
  .style-sketchbook .center h1::after,
  .style-sketchbook h1.ruled::after{
    content:"";position:absolute;left:4%;right:14%;bottom:-26px;height:10px;
    background:
      linear-gradient(var(--accent),var(--accent)) left 0 top 0/100% 4px no-repeat,
      linear-gradient(var(--accent),var(--accent)) left 6% top 9px/86% 3px no-repeat;
    border-radius:50%;opacity:.85;
  }
  .style-sketchbook h2{font-size:62px;font-weight:700;line-height:1.08}
  .style-sketchbook .sub{color:var(--muted);font-weight:600;font-size:38px}
  /* Filled marker dots, sitting a touch high like a hand-placed bullet. */
  .style-sketchbook li{padding-left:52px}
  .style-sketchbook li::before{
    width:22px;height:22px;border-radius:50%;background:var(--accent);
    top:.42em;
  }
  .style-sketchbook li:nth-child(2n)::before{transform:translateY(-1px) rotate(8deg)}
  /* Boxes are drawn, so they get the wobble and a sketchy offset shadow
     rather than a blur — ink does not have a soft edge. */
  .style-sketchbook .stat,
  .style-sketchbook .tile,
  .style-sketchbook .photo,
  .style-sketchbook .inset,
  .style-sketchbook .ctrack{
    border:3px solid var(--fg);
    border-radius:230px 15px 210px 15px/15px 210px 15px 230px;
    box-shadow:5px 6px 0 rgba(31,27,22,.16);
  }
  .style-sketchbook .stat{background:var(--card);border-left-width:3px}
  .style-sketchbook .tile{background:var(--card);border-left:3px solid var(--fg)}
  .style-sketchbook .cfill{background:var(--accent)}
  .style-sketchbook .badge{
    border:3px solid var(--fg);border-radius:200px 14px 180px 14px/14px 180px 14px 200px;
    background:var(--card);
  }
  .style-sketchbook .repologo{
    border:3px solid var(--fg);
    border-radius:210px 16px 190px 16px/16px 190px 16px 210px;
  }
  /* A pencil rule, not a hairline: uneven and warm. */
  .style-sketchbook td{border-bottom:3px solid var(--rule)}
  .style-sketchbook .srcs div{color:var(--muted)}
  .style-sketchbook footer{margin-top:26px;font-weight:700;color:var(--accent2)}
  .style-sketchbook .handle{color:var(--fg)}
  .style-sketchbook .fmark{
    background:var(--accent);color:#FFFDF7;border:3px solid var(--fg);
    border-radius:50%;
  }
  .style-sketchbook ol.linklist .ln{
    border:3px solid var(--fg);background:var(--card);
    border-radius:200px 14px 180px 14px/14px 180px 14px 200px;
  }
  .style-sketchbook[data-shrink="1"] h1{font-size:76px}
  .style-sketchbook[data-shrink="1"] .sub{font-size:31px}


  /* ============== DOODLE — marker on pure white, text only ==============
     Signature: a hand-lettered headline, one red hand-drawn stroke under it,
     and nothing else. No kicker (the markup skips it), no cards, borders,
     colour fields or images (slide images are not rendered for this style).
     Everything is centred and the whitespace is the design.
     Fonts, bundled locally so the render never needs the network:
       Shantell Sans (variable, OFL 1.1, github.com/google/fonts ofl/shantellsans) - headlines
       Patrick Hand  (OFL 1.1, github.com/google/fonts ofl/patrickhand)            - body
     Licence texts live next to the files in config/fonts/doodle. */
  {% if theme.style == 'doodle' %}
  @font-face{font-family:'Doodle Marker';font-weight:300 800;
    src:url('{{ fonts_uri }}/doodle/ShantellSans-Variable.ttf') format('truetype')}
  @font-face{font-family:'Doodle Hand';font-weight:400;
    src:url('{{ fonts_uri }}/doodle/PatrickHand-Regular.ttf') format('truetype')}
  {% endif %}
  .style-doodle{
    --marker:'Doodle Marker','Shantell Sans','Marker Felt','Comic Sans MS',cursive;
    --stroke:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 16' preserveAspectRatio='none'><path d='M3 10 C 38 5, 78 12, 128 8 S 214 5, 262 10 S 289 7, 297 9' fill='none' stroke='{{ theme.accent|replace('#','%23') }}' stroke-width='4.2' stroke-linecap='round'/></svg>");
    padding:96px 84px 64px;font-family:var(--font);
  }
  .style-doodle .body{align-items:center;text-align:center;justify-content:center;gap:40px;padding-bottom:40px}
  .style-doodle .body.center{justify-content:center}
  .style-doodle h1,.style-doodle h2,.style-doodle .reponame,.style-doodle blockquote,
  .style-doodle .fmark,.style-doodle .tval,.style-doodle .stat .v,.style-doodle .cval{
    font-family:var(--marker);color:var(--fg);
  }
  .style-doodle h1{font-size:112px;font-weight:500;line-height:1.1;letter-spacing:-.01em}
  .style-doodle h2{font-size:66px;font-weight:400;line-height:1.18;letter-spacing:0}
  /* One red hand-drawn stroke under the headline (content slides) or under a
     single word of it (hook, see the doodle_underline filter). The stroke is
     an SVG path, not a border, so it wobbles. */
  .style-doodle h2::after{content:"";display:block;height:18px;width:84%;margin:20px auto 0;background:var(--stroke) center/100% 100% no-repeat;margin-top:22px}
  .style-doodle h1 .ul{
    display:inline-block;padding-bottom:20px;margin-bottom:-4px;
    background:var(--stroke) left bottom/100% 18px no-repeat;
  }
  .style-doodle .sub{color:var(--muted);font-size:54px;line-height:1.28;font-weight:400}
  .style-doodle .sub.small{font-size:48px}
  .style-doodle ul,.style-doodle .repobullets{align-items:center;gap:26px}
  .style-doodle li,.style-doodle .repobullets li{
    padding-left:0;font-size:42px;line-height:1.3;text-align:center;
  }
  .style-doodle li::before{display:none}
  .style-doodle .stat{background:none;border:0;padding:0}
  .style-doodle .stat .v{font-size:110px;color:var(--accent)}
  .style-doodle .stat .l{font-size:46px;color:var(--muted)}
  .style-doodle table,.style-doodle tbody{display:block;width:100%}
  .style-doodle tr{display:flex;flex-direction:column;align-items:center;margin-bottom:26px}
  .style-doodle td{display:block;border:0;padding:0;width:auto;text-align:center}
  .style-doodle td:first-child{font-size:42px;color:var(--muted);width:auto}
  .style-doodle td:last-child{font-size:52px;font-weight:400;color:var(--fg)}
  /* chart: one red stroke per bar, black numbers. The track is invisible. */
  /* the body centres its children, so a block that must span needs a width */
  .style-doodle .chart{width:100%}
  .style-doodle .crow{grid-template-columns:300px 1fr 170px}
  .style-doodle .clabel{font-size:40px;color:var(--fg)}
  .style-doodle .ctrack{background:none;height:40px;border-radius:0}
  .style-doodle .cbar{background:var(--accent);border-radius:30px 12px 26px 10px/14px 18px 12px 16px}
  .style-doodle .cval{font-size:46px;font-weight:700;text-align:left}
  .style-doodle .cunit{color:var(--muted);font-size:38px}
  .style-doodle .kpis{gap:44px 30px;width:100%}
  .style-doodle .tile{
    background:none;border:0;border-radius:0;padding:0;align-items:center;
    text-align:center;gap:4px;
  }
  .style-doodle .tval{font-size:88px;font-weight:700;color:var(--fg)}
  .style-doodle .kpis-3 .tval,.style-doodle .kpis-4 .tval{font-size:66px}
  .style-doodle .tdelta{color:var(--accent);font-size:42px;font-weight:400}
  .style-doodle .tlabel{font-size:40px;color:var(--muted)}
  /* code keeps its monospace and its left-aligned lines; only the box goes. */
  .style-doodle .codeblock{background:none;padding:0;border-radius:0;
    width:100%;text-align:left;display:flex;flex-direction:column;align-items:center}
  .style-doodle .codeblock pre{font-size:36px;color:var(--fg);width:100%;line-height:1.4}
  .style-doodle .codeblock .lang{position:static;background:none;color:var(--accent);font-size:32px;padding:0 0 14px;border-radius:0}
  .style-doodle ol.flow{align-items:center;gap:26px}
  .style-doodle ol.flow li{flex-direction:column;align-items:center;gap:0;padding:0}
  .style-doodle ol.flow li::after{display:none}
  .style-doodle ol.flow .n{
    background:none;width:auto;height:auto;border-radius:0;color:var(--accent);
    font-family:var(--marker);font-size:44px;font-weight:700;
  }
  .style-doodle ol.flow .txt{align-items:center;padding-top:0;gap:4px}
  .style-doodle ol.flow b{font-family:var(--marker);font-size:48px;font-weight:600}
  .style-doodle ol.flow i{font-size:38px;color:var(--muted)}
  .style-doodle .vs{justify-content:center;gap:56px;width:100%}
  .style-doodle .vs .col{padding:0;align-items:center;text-align:center}
  .style-doodle .vs .split{display:none}
  .style-doodle .vs .colhead{border:0;padding:0;font-family:var(--marker);font-size:40px;letter-spacing:0;text-transform:none;color:var(--fg)}
  .style-doodle .vs .colhead.alt{color:var(--accent)}
  .style-doodle .vs .cell{font-size:42px}
  .style-doodle .vs .cell.strong{font-weight:400}
  .style-doodle blockquote{font-size:58px;font-weight:600;line-height:1.22;letter-spacing:0}
  .style-doodle blockquote::before{color:var(--accent);font-size:130px;margin-bottom:10px}
  .style-doodle .kicker-sm{font-size:44px;letter-spacing:0;text-transform:none;color:var(--muted);font-weight:400}
  .style-doodle .attrib{font-size:44px;color:var(--muted)}
  .style-doodle .repohead{flex-direction:column;gap:6px;margin-top:0}
  .style-doodle .repometa{justify-content:center;margin-top:0}
  .style-doodle .repoowner{font-family:var(--font);font-size:42px;color:var(--muted)}
  .style-doodle .reponame{font-size:72px;font-weight:700;letter-spacing:0}
  .style-doodle .badge{background:none;padding:0;font-family:var(--font);font-size:34px;
    letter-spacing:0;color:var(--muted)}
  .style-doodle .stars{font-size:36px;font-weight:400;color:var(--accent)}
  .style-doodle .repourl{border:0;padding-top:0;font-size:32px;color:var(--accent)}
  .style-doodle ol.linklist{align-items:center;gap:22px}
  .style-doodle ol.linklist li{justify-content:center;gap:14px}
  .style-doodle ol.linklist .ln{background:none;color:var(--accent);padding:0;border-radius:0;font-family:var(--marker);font-size:40px}
  .style-doodle ol.linklist .lu{font-size:30px}
  .style-doodle .srcs{align-items:center;gap:18px}
  .style-doodle .srcs div{font-family:var(--font);font-size:38px;color:var(--muted);line-height:1.3}
  .style-doodle .follow{gap:26px}
  .style-doodle .fmark{border:0;border-radius:0;padding:0 0 22px;margin-bottom:12px;font-size:78px;font-weight:500;letter-spacing:0;color:var(--fg);background:var(--stroke) left bottom/100% 18px no-repeat}
  .style-doodle footer{justify-content:center;gap:28px;font-size:28px;color:#8C8C8C;display:none}
  .style-doodle .handle{color:#8C8C8C;font-weight:400}
  .style-doodle{padding:96px 84px 96px}
  .style-doodle h1,.style-doodle h2{text-wrap:balance}
  .style-doodle li{font-size:54px;line-height:1.28}
  .style-doodle ul:not(.repobullets):has(li:nth-child(4)) li{font-size:48px}
  .style-doodle ul:not(.repobullets):has(li:nth-child(3)) li{font-size:50px}
  .style-doodle .repobullets li{font-size:44px;line-height:1.26}
  .style-doodle ol.flow .n,.style-doodle .fmark{font-size:64px}
  .style-doodle .badge,.style-doodle .stars{font-size:42px}

  /* ================== AURORA — soft gradient glass =================
     Signature: a frosted card floating on a mesh gradient. The 2026 soft
     premium look, and the only theme here where the background does work. */
  .style-aurora{
    background:
      radial-gradient(1100px 900px at 12% 8%,  #7C3AED 0%, transparent 60%),
      radial-gradient(1000px 800px at 88% 22%, #2563EB 0%, transparent 58%),
      radial-gradient(1200px 900px at 70% 92%, #FB7185 0%, transparent 62%),
      radial-gradient(900px 700px at 20% 85%,  #FDBA74 0%, transparent 60%),
      var(--bg);
  }
  .style-aurora .frame{
    flex:1;display:flex;flex-direction:column;min-height:0;
    background:var(--card);border:1px solid var(--rule);
    border-radius:44px;padding:64px 56px;
    box-shadow:0 30px 80px rgba(0,0,0,.28);
  }
  .style-aurora .kicker{color:var(--accent);margin-bottom:28px}
  .style-aurora h1,.style-aurora h2{text-shadow:0 2px 20px rgba(0,0,0,.25)}
  .style-aurora .sub{color:var(--muted)}
  .style-aurora li::before{
    background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:50%;
  }
  .style-aurora .stat{border-left-color:var(--accent);border-radius:24px}
  .style-aurora td{border-bottom:1px solid var(--rule)}
  .style-aurora footer{margin-top:24px}

  /* per-theme treatment of charts and tiles */
  .style-newsprint .ctrack,.style-newsprint .tile{border-radius:0}
  .style-newsprint .cbar{border-radius:0}
  .style-blockprint .ctrack{border-radius:0;border:4px solid var(--fg);height:56px;
                            background:transparent}
  .style-blockprint .cbar{border-radius:0;background:var(--fg)}
  .style-blockprint .tile{border-radius:0;border:5px solid var(--fg);
                          border-left-width:5px;box-shadow:8px 8px 0 var(--fg)}
  .style-aurora .ctrack{background:rgba(0,0,0,.25)}
  .style-aurora .cbar{background:linear-gradient(90deg,var(--accent),var(--accent2))}
  .style-aurora .tile{border-radius:24px;border-left-color:var(--accent)}

  .slide[data-shrink="1"] .crow{grid-template-columns:200px 1fr 120px;gap:16px}
  .slide[data-shrink="1"] .clabel{font-size:25px}
  .slide[data-shrink="1"] .cval{font-size:28px}
  .slide[data-shrink="1"] .ctrack{height:42px}
  .slide[data-shrink="1"] .tval{font-size:58px}
  .slide[data-shrink="1"] .kpis{gap:18px}
  .slide[data-shrink="1"] .tile{padding:26px 24px}
  /* doodle shrink step (~15%). This block MUST stay after the generic
     `.slide[data-shrink="1"]` rules above (same specificity, so source order
     decides) or those rules win and the doodle sizes are dead. */
  .style-doodle[data-shrink="1"] h1{font-size:96px}
  .style-doodle[data-shrink="1"] h2{font-size:58px}
  .style-doodle[data-shrink="1"] .sub{font-size:44px}
  .style-doodle[data-shrink="1"] li,.style-doodle[data-shrink="1"] .repobullets li{font-size:44px;line-height:1.24}
  .style-doodle[data-shrink="1"] ul,.style-doodle[data-shrink="1"] .repobullets{gap:22px}
  .style-doodle[data-shrink="1"] .body{gap:30px}
  .style-doodle[data-shrink="1"] ol.flow{gap:16px}
  .style-doodle[data-shrink="1"] ol.flow b{font-size:44px}
  .style-doodle[data-shrink="1"] ol.flow i{font-size:36px}
  .style-doodle[data-shrink="1"] ol.flow li{padding-bottom:0}
  .style-doodle[data-shrink="1"] ol.linklist .lu{font-size:30px}
  .style-doodle[data-shrink="1"] ol.linklist .ln{font-size:38px}
  .style-doodle[data-shrink="1"] ol.linklist{gap:18px}
  .style-doodle[data-shrink="1"] .tval{font-size:56px}
  .style-doodle[data-shrink="1"] .clabel{font-size:34px}
  .style-doodle[data-shrink="1"] .codeblock pre{font-size:28px}
  .style-doodle[data-shrink="1"] .vs .cell{font-size:36px}
  .style-doodle[data-shrink="1"] blockquote{font-size:48px}
  .style-doodle[data-shrink="1"] td{padding:0}
  .style-doodle[data-shrink="1"] table{font-size:inherit}
  .style-doodle[data-shrink="1"] tr{margin-bottom:18px}
  .style-doodle[data-shrink="1"] td:first-child{font-size:36px}
  .style-doodle[data-shrink="1"] td:last-child{font-size:46px}
  .style-doodle[data-shrink="1"] .tile{padding:0}
  .style-doodle[data-shrink="1"] .kpis{gap:30px 24px}
  .style-doodle[data-shrink="1"] .tlabel{font-size:34px}
  .style-doodle[data-shrink="1"] .tdelta{font-size:36px}
  .style-doodle[data-shrink="1"] .crow{grid-template-columns:240px 1fr 140px;gap:18px}
  .style-doodle[data-shrink="1"] .cval{font-size:40px}
  .style-doodle[data-shrink="1"] .ctrack{height:34px}
  .style-doodle[data-shrink="1"] .stat .v{font-size:92px}
  .style-doodle[data-shrink="1"] .stat .l{font-size:40px}
  .style-doodle[data-shrink="1"] .srcs div{font-size:32px}
  .style-doodle[data-shrink="1"] .reponame{font-size:60px}
  .style-doodle[data-shrink="1"] .repourl{font-size:28px}
  .style-doodle[data-shrink="1"] .repodesc{font-size:40px}

  /* per-theme treatment of the new types */
  .style-newsprint .codeblock{background:#E4E6EA;border-left:6px solid var(--accent);
                              border-radius:0}
  .style-newsprint .codeblock .lang{background:var(--accent2);color:#fff;border-radius:0}
  .style-newsprint ol.flow .n{border-radius:0;background:var(--accent)}
  .style-newsprint blockquote{font-family:var(--font);font-weight:700}

  .style-blockprint .codeblock{background:var(--card);border:5px solid var(--fg);
                               border-radius:0;box-shadow:8px 8px 0 var(--fg)}
  .style-blockprint .codeblock .lang{background:var(--fg);color:var(--card);border-radius:0}
  .style-blockprint ol.flow .n{border-radius:0;background:var(--fg);color:var(--card)}
  .style-blockprint ol.flow li::after{background:var(--fg);width:4px}
  .style-blockprint .vs .split,.style-blockprint .vs .colhead{background:none;
                               border-color:var(--fg)}
  .style-blockprint .vs .split{background:var(--fg);width:4px}
  .style-blockprint blockquote{text-transform:uppercase;letter-spacing:-.03em}

  .style-aurora .codeblock{background:rgba(0,0,0,.28);border:1px solid var(--rule);
                           border-radius:22px}
  .style-aurora ol.flow .n{background:linear-gradient(135deg,var(--accent),var(--accent2));
                           color:#1A1033}

  .style-newsprint .mdbody ol>li::before,.style-blockprint .mdbody ol>li::before{border-radius:0}
  .style-blockprint .mdbody ol>li::before{background:var(--fg);color:var(--card)}
  .style-blockprint .mdbody th{color:var(--fg);border-bottom-color:var(--fg)}
  .style-blockprint .mdbody blockquote{border-left-color:var(--fg);text-transform:none}
  .style-blockprint .mdbody td{border-bottom:3px solid var(--fg)}
  .style-aurora .mdbody ol>li::before{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#1A1033}
  .style-sketchbook .mdbody ol>li::before{border-radius:50% 46% 54% 48%/48% 54% 46% 52%;top:4px}

  /* doodle: centred hand-lettered text; its table rules turn cells into stacked
     blocks (made for 2-column facts), so a Markdown table gets a real grid back. */
  .style-doodle .mdbody{align-items:center;text-align:center}
  .style-doodle .mdbody p{font-size:46px;line-height:1.28}
  .style-doodle .mdbody p.mdh{font-size:52px}
  .style-doodle .mdbody li,.style-doodle .mdbody li li{font-size:44px;line-height:1.26;padding-left:0;text-align:center}
  .style-doodle .mdbody ul,.style-doodle .mdbody ol{align-items:center;gap:20px}
  .style-doodle .mdbody ol>li{padding-left:0}
  .style-doodle .mdbody ol>li::before{display:inline-block;position:static;width:auto;height:auto;
    background:none;color:var(--accent);font-size:inherit;line-height:inherit;margin-right:12px}
  .style-doodle .mdbody ol>li::before{content:counter(md) "."}
  .style-doodle .mdbody blockquote{font-size:50px;border-left:0;padding:0}
  .style-doodle .mdbody table{display:table;width:100%;font-size:38px}
  .style-doodle .mdbody thead{display:table-header-group}
  .style-doodle .mdbody tbody{display:table-row-group}
  .style-doodle .mdbody tr{display:table-row;margin:0}
  .style-doodle .mdbody th{display:table-cell;font-size:34px;letter-spacing:0;text-transform:none;
                           border-bottom:4px solid var(--accent);text-align:center}
  .style-doodle .mdbody td,.style-doodle .mdbody td:first-child,.style-doodle .mdbody td:last-child{
    display:table-cell;font-size:38px;color:var(--fg);font-weight:400;text-align:center;
    padding:14px 12px;border:0}
  .style-doodle[data-shrink="1"] .mdbody p{font-size:38px}
  .style-doodle[data-shrink="1"] .mdbody li,.style-doodle[data-shrink="1"] .mdbody li li{font-size:36px}
  .style-doodle[data-shrink="1"] .mdbody table{font-size:32px}
  .style-doodle[data-shrink="1"] .mdbody th{font-size:28px}
  .style-doodle[data-shrink="1"] .mdbody td,.style-doodle[data-shrink="1"] .mdbody td:first-child,
  .style-doodle[data-shrink="1"] .mdbody td:last-child{font-size:32px;padding:8px 10px}

</style>
{% endautoescape %}
{% set style = theme.style if theme.style else 'signal' %}
{% for s in slides %}
{% set pos = loop.index %}
{% set field = theme.palette[loop.index0 % theme.palette|length] if theme.palette else None %}
{# doodle is text-only by design: no photo, no background image. #}
{% set bg = s.image_uri if s.image_mode == 'background' and s.image_uri and style != 'doodle' else None %}
<div class="slide style-{{ style }}{{ ' has-bg' if bg else '' }}" id="slide-{{ loop.index0 }}"
     {% if field %}style="background:{{ field }}"{% endif %}>
  {% if bg %}<div class="bg"><img src="{{ bg }}" alt=""></div>{% endif %}

  {% if style == 'signal' %}
    {# Segments lit up to the current slide: how far in you are, at a glance. #}
    <div class="meter">
      {%- for _ in slides -%}
        <i class="{{ 'on' if loop.index <= pos else '' }}"></i>
      {%- endfor -%}
    </div>
  {% endif %}

  {% if style == 'newsprint' %}
    <div class="slug">{{ theme.handle }} &middot; {{ theme.kickers.get(s.type, 'DISPATCH') }} &middot; {{ '%02d'|format(loop.index) }} of {{ '%02d'|format(slides|length) }}</div>
  {% elif style != 'doodle' %}
    <div class="kicker">{{ theme.kickers.get(s.type, theme.kickers['hook']) }}</div>
  {% endif %}

  {% if style in ('blockprint', 'aurora') %}<div class="frame">{% endif %}
  <div class="body{% if s.type in ('hook', 'takeaway') %} center{% endif %}">
    {% include 'slides/' ~ s.type ~ '.html.j2' %}
    {% if s.image_mode == 'inset' and s.image_uri and s.type != 'photo' and style != 'doodle' %}
      <div class="inset"><img src="{{ s.image_uri }}" alt=""></div>
    {% endif %}
  </div>
  {% if style in ('blockprint', 'aurora') %}</div>{% endif %}

  <footer>
    <span class="handle">{{ theme.handle }}</span>
    <span>{{ loop.index }} / {{ slides|length }}</span>
  </footer>
</div>
{% endfor %}
