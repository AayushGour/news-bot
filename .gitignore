# secrets — must be first, before any credential exists
# `.env` alone is not enough: a timestamped backup (.env.backup-20260913-142822)
# sat outside the pattern and was staged for a push to a public remote with a
# live Instagram token, bot token and OpenRouter key in it.
.env
.env.*
!.env.example
secrets/
*.session
*.session-journal

# runtime data
data/
poc/out/

# python
__pycache__/
*.py[cod]
.venv/
poc/.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# os
.DS_Store

.code-review-graph/
